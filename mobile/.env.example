# Base URL of the ConductNexus API, including /api/v1.
# Android emulator: http://10.0.2.2:4000/api/v1
# iOS simulator:    http://localhost:4000/api/v1
# Physical device:  http://<your-LAN-IP>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# EAS project id (from `eas init`). Used for Expo push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In OAuth web client id (required to show the Google button).
# Create one in Firebase / Google Cloud and enable the Google provider.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Firebase web app config (same project as the backend FIREBASE_PROJECT_ID).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
