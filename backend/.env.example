# ── ConductNexus API ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Comma-separated list. In production add every frontend origin, e.g.
# CORS_ORIGIN=https://e-visitors-d4830.web.app,https://e-visitors-d4830.firebaseapp.com
CORS_ORIGIN=http://localhost:5173

# MongoDB. Local default:
MONGODB_URI=mongodb://127.0.0.1:27017/conductnexus
# MongoDB Atlas (production). Create the user under Database Access, then add
# your IP (or 0.0.0.0/0 for Render) under Network Access:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/conductnexus?retryWrites=true&w=majority

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Firebase (for Google Sign-In) — Firebase console > Project settings > General > Web app
FIREBASE_PROJECT_ID=

# SMTP email (verification, password reset and two-factor codes).
# Leave blank to use the in-app dev outbox (development only).
# For a Gmail account, create an App Password (Google Account > Security >
# 2-Step Verification > App passwords) and use these values:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=the-16-character-app-password
# MAIL_FROM must stay the same address as SMTP_USER for Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Gmail OAuth2 alternative (preferred over an app password).
# Create an OAuth client in Google Cloud Console, authorise it once with the
# https://mail.google.com/ scope, then paste the refresh token here.
# When all four are set, they take precedence over the SMTP_* values above.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Mailjet Send API v3.1. When both keys are set, this transport is used before
# Gmail OAuth2 and SMTP. The sender address must be verified in
# Mailjet > Senders & Domains, and MAIL_FROM (or MAILJET_SENDER) must use it.
# Verify delivery with: npm run mail:test -- you@example.com
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER=

# Minimum seconds between repeated two-factor code requests (30-300)
TWO_FACTOR_RESEND_SECONDS=60

# Backup encryption key: 64 hex characters (32 bytes)
BACKUP_ENCRYPTION_KEY=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# WhatsApp (optional; requires `npm i whatsapp-web.js` and Chromium/Edge)
# If Chrome is already installed, install with PUPPETEER_SKIP_DOWNLOAD=true and
# point this at the browser executable (leave blank to use puppeteer's own Chrome).
ENABLE_WHATSAPP=false
WHATSAPP_SESSION=conductnexus
WHATSAPP_EXECUTABLE_PATH=
# Optional: pin static.whatsapp.net when the local DNS resolver cannot reach the CDN
WHATSAPP_RESOLVER_IP=
# Optional: link with a pairing code instead of a QR scan. Digits only, with country code.
# Administrators can also type the number in Communications → WhatsApp → "Use phone number".
WHATSAPP_PAIR_PHONE=

# Expo push notifications (optional). Set this when "Enhanced Push Security"
# is enabled for the Expo project; leave blank otherwise.
EXPO_ACCESS_TOKEN=

# SMS — Africa's Talking (optional). SMS is only used when an administrator
# enables it in Settings → Communications. WhatsApp stays the default channel.
# Use AT_USERNAME=sandbox for the Africa's Talking sandbox.
AT_USERNAME=
AT_API_KEY=
# Optional registered alphanumeric sender ID; leave blank to use the AT shortcode.
AT_SENDER_ID=
# Optional URL override, e.g. https://api.sandbox.africastalking.com/version1/messaging
AT_SMS_URL=

# First-run / CLI seed (used only by `npm run seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
SCHOOL_NAME=
