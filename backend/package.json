{
  "name": "conductnexus-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "cleanup:demo": "tsx src/scripts/cleanup-demo.ts",
    "purge:queue": "tsx src/scripts/purge-non-whatsapp-queue.ts",
    "queue:status": "tsx src/scripts/queue-status.ts",
    "rbac:sync": "tsx src/scripts/sync-rbac.ts",
    "migrate": "tsx src/scripts/migrate.ts run",
    "migrate:status": "tsx src/scripts/migrate.ts status",
    "backup:drill": "tsx src/scripts/backup-drill.ts",
    "smoke:students": "tsx src/scripts/smoke-student-upgrade.ts",
    "smoke:password": "tsx src/scripts/smoke-password.ts",
    "clean:smoke": "tsx src/scripts/clean-smoke.ts",
    "resend:incidents": "tsx src/scripts/resend-incident-messages.ts",
    "recover-admin": "tsx src/scripts/recover-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "tsx src/scripts/setup.ts",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "mail:test": "tsx src/scripts/test-email.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "^1.34.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
