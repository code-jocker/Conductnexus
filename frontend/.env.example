# ── ConductNexus Web ─────────────────────────────────────────────
# Local development: keep the relative URL so the Vite proxy forwards to the API.
# Production (Firebase Hosting): use the full Render API URL, e.g.
# VITE_API_URL=https://conductnexus-api.onrender.com/api/v1
# VITE_SOCKET_URL=https://conductnexus-api.onrender.com
VITE_API_URL=/api/v1
VITE_SOCKET_URL=

# Firebase web app config (Firebase console > Project settings > Your apps > Web)
# These identifiers are public client config; never put a service account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

VITE_SCHOOL_NAME=ConductNexus
